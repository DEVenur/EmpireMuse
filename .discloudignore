# Discloud ignore file - EmpireMuse
# Define arquivos e diretorios que NAO devem ser enviados no pacote de deploy da Discloud.

# Ambiente de desenvolvimento, controle de versao e orquestracao de agentes
.git/
.github/
.claude/
.agents/
.maestri/
repos/
worktrees/
.arquivo/
.local/
.venv/
venv/
.idea/
.vscode/

# Testes automatizados e documentacao
tests/
docs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Arquivos de container e deploy de outras plataformas
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.override.yml
deploy/

# Caches de runtime e arquivos temporarios
__pycache__/
*.py[cod]
*.pkl
.ytdl_cache/
.lastfm_cache
.lastfm_cache/
.spotify_cache.json
.tempjar/
.logs/
*.zip

# Binarios e arquivos de execucao do Lavalink (o bot gerencia ou usa nos remotos)
.java/
Lavalink.jar
application.yml
plugins/
lavalink.ini
auto_lavalink.ini

# Persistencia local (nao sobrescrever dados de producao no upload)
local_database/
local_database

# Variaveis de ambiente:
# Bloqueia arquivos de ambiente auxiliares (.env.mongo, .env.example, backups, etc.).
# O arquivo principal (.env) NAO e ignorado aqui para permitir o upload de credenciais
# pelo usuario ao gerar o zip de deploy na Discloud (conforme documentacao oficial).
.env.*
config.json
