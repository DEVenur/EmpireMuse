##############################################################################################################
### Atenção: A RAM você pode alterar de acordo com o plano contratado (ou quantidade desejada).            ###
### Recomendo que use um plano pago que forneça no mínimo 512MB de RAM + 0.5vcpu e edite o arquivo .env    ###
### e no campo AUTO_DOWNLOAD_LAVALINK_SERVERLIST mude o valor true para false                              ###
###                                                                                                        ###
### Caso queira, você pode alterar o DISPLAY_NAME, DESCRIPTION e link do AVATAR.                           ###
##############################################################################################################

DISPLAY_NAME=EmpireMuse
DESCRIPTION=EmpireMuse — bot de música para Discord (GPL-2.0) · https://github.com/DiscordEmpireHub/EmpireMuse
MAIN=main.py
MEMORY=512
VERSION=recommended
