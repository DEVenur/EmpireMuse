# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source files
*.py diff=python
*.sh eol=lf
*.bat eol=crlf
*.cmd eol=crlf

# Binary files - Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.tiff binary

# Binary files - Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Binary files - Archives & Packages
*.jar binary
*.zip binary
*.tar.gz binary
*.gz binary
*.7z binary
*.rar binary
