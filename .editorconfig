# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,toml,md,html,htm,css,js}]
indent_style = space
indent_size = 2

